# ---------------------------------------------------------------------------
# Secrets — never commit these.
# ---------------------------------------------------------------------------
# Holds the real API key. Copy setup_env.example.sh (which IS committed) to
# setup_env.sh, put your key in, and `source setup_env.sh`.
setup_env.sh
.env
.env.*
*.pem
*.key

# Local device wiring for the real-robot demo (lab IPs / ports).
# The committed *.example.json files document the format.
src/experiment/PEFA/tb_urls.json
turtlebot/objects.json
crazyflie/drone_objects.json
paper/*

# ---------------------------------------------------------------------------
# Downloaded data — not redistributable, ~29 GB total.
# og_dataset/assets/key come from scripts/download_datasets.py (BEHAVIOR EULA);
# Benchmark/assets is the robot asset bundle from the project's Drive folder.
# ---------------------------------------------------------------------------
OmniGibson/omnigibson/data/
OmniGibson/Benchmark/assets/

# ---------------------------------------------------------------------------
# ROS 2 / colcon build artifacts.
# The old ROS 1 catkin build/ and devel/ trees used to be committed upstream;
# they are regenerated by `colcon build` and are no longer tracked.
# ---------------------------------------------------------------------------
OmniGibson/Benchmark/ros_hademo_ws/build/
OmniGibson/Benchmark/ros_hademo_ws/install/
OmniGibson/Benchmark/ros_hademo_ws/devel/
OmniGibson/Benchmark/ros_hademo_ws/log/
OmniGibson/Benchmark/ros_hademo_ws/.catkin_workspace

# ---------------------------------------------------------------------------
# Run output. The authoritative benchmark evidence lives in results/bench/
# (per-task JSON records + report.txt + table_main.*) and IS committed.
# Raw LLM transcripts and orchestrator logs are regenerable noise.
# ---------------------------------------------------------------------------
src/experiment/*/log/orchestrator_*/
src/experiment/FOLBP/log/
src/experiment/FOLBP_hard/log/
src/experiment/*/log/*.log
src/experiment/*/log/log_test.txt
# Raw per-env LLM transcripts. Upstream committed these as empty placeholders;
# a full run fills each to 27-45 MB. Regenerable, and never cited by the paper.
src/experiment/*/log/env*.txt
*.log.gz
chat_raw.json
total_gpt_cost.txt

# Raw demo captures. A single run is a ~70-185 MB sim.mp4 plus its composed
# final.mp4, all regenerable with tools/record_demo.sh. The four videos actually
# referenced by the README live in results/demos/ and ARE committed.
results/videos/
# Original hardware captures. hardware_videos/ holds re-encodes under GitHub's
# 100 MB file limit; the camera originals stay here, locally.
hardware_videos/raw/
# Intermediate clips of the ICRA video; tools/icra_reel.sh rebuilds them.
results/icra_video/segments/

# Sweeps kept only locally. bench_25flash_fixed/ and bench_lite_probe/ are the
# records behind the paper's Table II; results/bench/ is the committed earlier sweep.
results/bench_25flash_fixed/
results/bench_lite_probe/
results/bench_multiseed/
results/*.log
src/results/

# Ad-hoc spreadsheets / scratch result dumps.
*.xlsx
results_dump/

